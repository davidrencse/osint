# Optional API keys. Sources that need a key are skipped (with a UI note) when unset.
# HaveIBeenPwned (breach lookup) — paid: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Shodan (host intel) — https://account.shodan.io
SHODAN_API_KEY=
# Hunter.io (email finder) — https://hunter.io/api-keys
HUNTER_API_KEY=

# Groq (FREE) — powers AI visual geolocation of photos with no usable metadata.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the vision model (default meta-llama/llama-4-scout-17b-16e-instruct)
GROQ_VISION_MODEL=

# Metadata geolocation (EXIF GPS, IPTC/XMP place tags) + OpenStreetMap geocoding
# remain fully free and need no keys.
