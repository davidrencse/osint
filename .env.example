# Optional API keys. Sources that need a key are skipped (with a UI note) when unset.
# HaveIBeenPwned (breach lookup) — paid: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Shodan (host intel) — https://account.shodan.io
SHODAN_API_KEY=
# Hunter.io (email finder) — https://hunter.io/api-keys
HUNTER_API_KEY=
# Vercel AI Gateway — powers Visual Geolocation (estimate photo location from pixels).
# Get one: https://vercel.com/dashboard (AI Gateway) or run `vercel link` for OIDC on Vercel.
AI_GATEWAY_API_KEY=
# Optional: override the vision model (default anthropic/claude-sonnet-4.6)
GEOVISION_MODEL=
