# Optional API keys. Sources that need a key are skipped (with a UI note) when unset.
# HaveIBeenPwned (breach lookup) — paid: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Shodan (host intel) — https://account.shodan.io
SHODAN_API_KEY=
# Hunter.io (email finder) — https://hunter.io/api-keys
HUNTER_API_KEY=

# AI visual geolocation (estimate a photo's location from pixels when it has no
# GPS/place metadata). Provider-agnostic: any OpenAI-compatible vision API.
#
# Default = Groq (FREE). Just set the key (GROQ_API_KEY also accepted):
VISION_API_KEY=
# Optional overrides (defaults shown) to switch provider/model:
# VISION_BASE_URL=https://api.groq.com/openai/v1
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Example — Google Gemini free tier (stronger vision):
# VISION_API_KEY=<aistudio key>
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_MODEL=gemini-2.0-flash

# Metadata geolocation (EXIF GPS, IPTC/XMP place tags) + OpenStreetMap geocoding
# remain fully free and need no keys.
